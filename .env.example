# Copy to `.env` for local overrides. Never commit `.env`.
# Scripts default to the well-known Anvil account #0 key when unset.

# Anvil / local RPC
ANVIL_RPC=http://127.0.0.1:8545

# Optional: override deployer / operator key (Anvil #0 is the default in scripts)
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional: fork URL for read-only / simulated analysis (never fund this key on mainnet)
# ETH_RPC_URL=https://eth-mainnet.example/YOUR_KEY
